{
  "datasets": [
    {
      "name": "9424e411",
      "displayName": "Sales by category",
      "queryLines": [
        "SELECT\r\n",
        "    p.category,\r\n",
        "    ROUND(SUM(f.sales), 2) AS revenue\r\n",
        "FROM retail_gold.fact_sales f\r\n",
        "JOIN retail_gold.dim_product p\r\n",
        "ON f.product_id = p.product_id\r\n",
        "GROUP BY p.category\r\n",
        "ORDER BY revenue DESC;"
      ]
    }
  ],
