{
  "datasets": [
    {
      "name": "2d460c55",
      "displayName": "Monthly Revenue",
      "queryLines": [
        "SELECT\r\n",
        "    CONCAT(d.year, '-', LPAD(d.month, 2, '0')) AS year_month,\r\n",
        "    ROUND(SUM(f.sales), 2) AS monthly_revenue\r\n",
        "FROM retail_gold.fact_sales f\r\n",
        "JOIN retail_gold.dim_date d\r\n",
        "ON f.order_date = d.order_date\r\n",
        "GROUP BY d.year, d.month\r\n",
        "ORDER BY d.year, d.month;"
      ]
    }
  ],
