{
  "datasets": [
    {
      "name": "fd2916e8",
      "displayName": "Regional Profit Insights",
      "queryLines": [
        "SELECT\r\n",
        "    c.region,\r\n",
        "    ROUND(SUM(f.profit), 2) AS total_profit\r\n",
        "FROM retail_gold.fact_sales f\r\n",
        "JOIN retail_gold.dim_customer c\r\n",
        "ON f.customer_id = c.customer_id\r\n",
        "GROUP BY c.region\r\n",
        "ORDER BY total_profit DESC;"
      ]
    }
  ],
