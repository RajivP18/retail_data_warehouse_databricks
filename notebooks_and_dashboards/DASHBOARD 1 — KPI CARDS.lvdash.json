      "displayName": "TOTAL PROFIT",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(SUM(profit), 2) AS total_profit\r\n",
        "FROM retail_gold.fact_sales;"
      ]
    },
    {
      "name": "ecfb157e",
      "displayName": "TOTAL ORDERS",
      "queryLines": [
        "SELECT\r\n",
